{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Phase 2, Notebook 02 -- ML Toolkit\n",
    "\n",
    "**Six Machine Learning Models vs Logistic Regression Baseline**\n",
    "\n",
    "This notebook compares six ML approaches on the same Phase 0 data and features used in Phase 1, answering: *can modern ML beat traditional logistic regression for PD modeling?*\n",
    "\n",
    "Models tested:\n",
    "1. Linear Discriminant Analysis (LDA) — parametric\n",
    "2. Support Vector Machine (SVM) — margin-maximizing\n",
    "3. K-Nearest Neighbors (KNN) — instance-based\n",
    "4. Random Forest — ensemble, bagging\n",
    "5. Gradient Boosting (XGBoost) — ensemble, boosting\n",
    "6. Neural Network — deep learning\n",
    "\n",
    "Target: 24+ month default (is_bad)\n",
    "Features: 31 Phase 0 cleaned columns (same as Phase 1)\n",
    "Comparison: AUC, KS, Gini, Calibration vs Phase 1 baseline (0.716)\n",
    "\n",
    "**Cell Map:**\n",
    "00. Connection & setup\n",
    "01. Load Phase 0, define train/val/test\n",
    "02-07. LDA / SVM / KNN / Random Forest / Gradient Boosting / Neural Network\n",
    "08. Feature importance comparison\n",
    "09. Side-by-side performance\n",
    "10. Calibration analysis\n",
    "11. Save models & tables"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 00 -- Connection & Setup"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.discriminant_analysis import LinearDiscriminantAnalysis\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "from sklearn.metrics import roc_auc_score, roc_curve, brier_score_loss\n",
    "import joblib\n",
    "import json\n",
    "from datetime import datetime\n",
    "import os\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "np.random.seed(42)\n",
    "print(\"Libraries imported.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load Phase 0 data\n",
    "phase0_data = pd.read_parquet('/mnt/user-data/uploads/Repos/credit-risk-portfolio/phase0_data_platform/01_lendingclub/data/03_processed/lendingclub_model_ready.parquet')\n",
    "print(f\"Phase 0 data shape: {phase0_data.shape}\")\n",
    "print(f\"Columns: {len(phase0_data.columns)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 01 -- Load Data & Create Train/Val/Test Split"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Answers:**\n",
    "- Same train/val/test split as Phase 1 (60/20/20)?\n",
    "- Same features (31 columns)?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define features (all numeric/categorical columns except target)\n",
    "exclude_cols = ['is_bad', 'issue_year', 'issue_d', 'member_id', 'id', 'policy_code']\n",
    "feature_cols = [col for col in phase0_data.columns if col not in exclude_cols]\n",
    "\n",
    "# Handle issue_year for train/test split\n",
    "if 'issue_d' in phase0_data.columns:\n",
    "    phase0_data['issue_year'] = pd.to_datetime(phase0_data['issue_d'], errors='coerce').dt.year\nelse:\n",
    "    phase0_data['issue_year'] = 2015\n",
    "\n",
    "# Train on 2013-2016, test on 2017\n",
    "in_time = phase0_data[phase0_data['issue_year'] < 2017].copy()\n",
    "\n",
    "# 60/20/20 split\n",
    "np.random.seed(42)\n",
    "indices = np.random.permutation(len(in_time))\n",
    "train_size = int(0.60 * len(in_time))\n",
    "val_size = int(0.20 * len(in_time))\n",
    "\n",
    "train_idx = indices[:train_size]\n",
    "val_idx = indices[train_size:train_size + val_size]\n",
    "test_idx = indices[train_size + val_size:]\n",
    "\n",
    "train_data = in_time.iloc[train_idx].reset_index(drop=True)\n",
    "val_data = in_time.iloc[val_idx].reset_index(drop=True)\n",
    "test_data = in_time.iloc[test_idx].reset_index(drop=True)\n",
    "\n",
    "print(f\"Train: {len(train_data):,}\")\n",
    "print(f\"Val:   {len(val_data):,}\")\n",
    "print(f\"Test:  {len(test_data):,}\")\n",
    "print(f\"\\nFeatures: {len(feature_cols)}\")\n",
    "\n",
    "# Prepare X, y\n",
    "X_train = train_data[feature_cols].fillna(train_data[feature_cols].median())\n",
    "y_train = train_data['is_bad']\n",
    "\n",
    "X_val = val_data[feature_cols].fillna(train_data[feature_cols].median())\n",
    "y_val = val_data['is_bad']\n",
    "\n",
    "X_test = test_data[feature_cols].fillna(train_data[feature_cols].median())\n",
    "y_test = test_data['is_bad']\n",
    "\n",
    "# Standardize\n",
    "scaler = StandardScaler()\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "X_val_scaled = scaler.transform(X_val)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "print(f\"\\nData prepared for modeling.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 02 -- Linear Discriminant Analysis (LDA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# LDA\n",
    "lda = LinearDiscriminantAnalysis(n_components=1, random_state=42)\n",
    "lda.fit(X_train_scaled, y_train)\n",
    "\n",
    "lda_pred_test = lda.predict_proba(X_test_scaled)[:, 1]\n",
    "lda_auc = roc_auc_score(y_test, lda_pred_test)\n",
    "lda_gini = 2 * lda_auc - 1\n",
    "\n",
    "print(f\"LDA Performance (Test):\")\n",
    "print(f\"AUC: {lda_auc:.4f}\")\n",
    "print(f\"Gini: {lda_gini:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 03 -- Support Vector Machine (SVM)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SVM with probability\n",
    "svm = SVC(kernel='rbf', probability=True, random_state=42, max_iter=1000)\n",
    "svm.fit(X_train_scaled, y_train)\n",
    "\n",
    "svm_pred_test = svm.predict_proba(X_test_scaled)[:, 1]\n",
    "svm_auc = roc_auc_score(y_test, svm_pred_test)\n",
    "svm_gini = 2 * svm_auc - 1\n",
    "\n",
    "print(f\"SVM Performance (Test):\")\n",
    "print(f\"AUC: {svm_auc:.4f}\")\n",
    "print(f\"Gini: {svm_gini:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 04 -- K-Nearest Neighbors (KNN)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# KNN (with reasonable k)\n",
    "knn = KNeighborsClassifier(n_neighbors=50)\n",
    "knn.fit(X_train_scaled, y_train)\n",
    "\n",
    "knn_pred_test = knn.predict_proba(X_test_scaled)[:, 1]\n",
    "knn_auc = roc_auc_score(y_test, knn_pred_test)\n",
    "knn_gini = 2 * knn_auc - 1\n",
    "\n",
    "print(f\"KNN Performance (Test):\")\n",
    "print(f\"AUC: {knn_auc:.4f}\")\n",
    "print(f\"Gini: {knn_gini:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 05 -- Random Forest"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Random Forest\n",
    "rf = RandomForestClassifier(n_estimators=100, max_depth=10, random_state=42, n_jobs=-1)\n",
    "rf.fit(X_train_scaled, y_train)\n",
    "\n",
    "rf_pred_test = rf.predict_proba(X_test_scaled)[:, 1]\n",
    "rf_auc = roc_auc_score(y_test, rf_pred_test)\n",
    "rf_gini = 2 * rf_auc - 1\n",
    "\n",
    "print(f\"Random Forest Performance (Test):\")\n",
    "print(f\"AUC: {rf_auc:.4f}\")\n",
    "print(f\"Gini: {rf_gini:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 06 -- Gradient Boosting (XGBoost-style)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gradient Boosting\n",
    "gb = GradientBoostingClassifier(n_estimators=100, max_depth=5, learning_rate=0.1, random_state=42)\n",
    "gb.fit(X_train_scaled, y_train)\n",
    "\n",
    "gb_pred_test = gb.predict_proba(X_test_scaled)[:, 1]\n",
    "gb_auc = roc_auc_score(y_test, gb_pred_test)\n",
    "gb_gini = 2 * gb_auc - 1\n",
    "\n",
    "print(f\"Gradient Boosting Performance (Test):\")\n",
    "print(f\"AUC: {gb_auc:.4f}\")\n",
    "print(f\"Gini: {gb_gini:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 07 -- Neural Network"
   ]
  },
  {
   "cell_type": {"text": "## 07 -- Neural Network"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Neural Network\n",
    "nn = MLPClassifier(hidden_layer_sizes=(64, 32), max_iter=1000, random_state=42, early_stopping=True)\n",
    "nn.fit(X_train_scaled, y_train)\n",
    "\n",
    "nn_pred_test = nn.predict_proba(X_test_scaled)[:, 1]\n",
    "nn_auc = roc_auc_score(y_test, nn_pred_test)\n",
    "nn_gini = 2 * nn_auc - 1\n",
    "\n",
    "print(f\"Neural Network Performance (Test):\")\n",
    "print(f\"AUC: {nn_auc:.4f}\")\n",
    "print(f\"Gini: {nn_gini:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 08 -- Feature Importance Comparison"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Answers:**\n",
    "- Which features are most important across models?\n",
    "- Do they agree?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract feature importance from tree-based models\n",
    "rf_importance = pd.DataFrame({\n",
    "    'feature': feature_cols,\n",
    "    'random_forest': rf.feature_importances_\n",
    "}).sort_values('random_forest', ascending=False).head(10)\n",
    "\n",
    "gb_importance = pd.DataFrame({\n",
    "    'feature': feature_cols,\n",
    "    'gradient_boosting': gb.feature_importances_\n",
    "}).sort_values('gradient_boosting', ascending=False).head(10)\n",
    "\n",
    "print(\"Top 10 Features - Random Forest:\")\n",
    "print(rf_importance.to_string())\n",
    "\n",
    "print(\"\\nTop 10 Features - Gradient Boosting:\")\n",
    "print(gb_importance.to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 09 -- Side-by-Side Performance Comparison"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Answers:**\n",
    "- Which model wins?\n",
    "- How much better than Phase 1 baseline?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Logistic Regression baseline (Phase 1)\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "lr = LogisticRegression(max_iter=1000, random_state=42)\n",
    "lr.fit(X_train_scaled, y_train)\n",
    "lr_pred_test = lr.predict_proba(X_test_scaled)[:, 1]\n",
    "lr_auc = roc_auc_score(y_test, lr_pred_test)\n",
    "lr_gini = 2 * lr_auc - 1\n",
    "\n",
    "# Comparison table\n",
    "comparison = pd.DataFrame({\n",
    "    'Model': ['Logistic Regression (Phase 1)', 'LDA', 'SVM', 'KNN', 'Random Forest', 'Gradient Boosting', 'Neural Network'],\n",
    "    'AUC': [lr_auc, lda_auc, svm_auc, knn_auc, rf_auc, gb_auc, nn_auc],\n",
    "    'Gini': [lr_gini, lda_gini, svm_gini, knn_gini, rf_gini, gb_gini, nn_gini],\n",
    "    'Delta_AUC': [0, lda_auc-lr_auc, svm_auc-lr_auc, knn_auc-lr_auc, rf_auc-lr_auc, gb_auc-lr_auc, nn_auc-lr_auc]\n",
    "}).round(4).sort_values('AUC', ascending=False)\n",
    "\n",
    "print(\"Model Comparison (Test Set):\")\n",
    "print(comparison.to_string(index=False))\n",
    "\n",
    "winner = comparison.iloc[0]\n",
    "print(f\"\\n🏆 Winner: {winner['Model']} (AUC: {winner['AUC']:.4f})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10 -- Calibration & Brier Score"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Answers:**\n",
    "- Which models are well-calibrated?\n",
    "- Brier score vs baseline?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Brier scores\n",
    "brier_baseline = brier_score_loss(y_test, np.full_like(y_test, y_test.mean()))\n",
    "\n",
    "brier_scores = pd.DataFrame({\n",
    "    'Model': ['Logistic Regression', 'LDA', 'SVM', 'KNN', 'Random Forest', 'Gradient Boosting', 'Neural Network'],\n",
    "    'Brier_Score': [\n",
    "        brier_score_loss(y_test, lr_pred_test),\n",
    "        brier_score_loss(y_test, lda_pred_test),\n",
    "        brier_score_loss(y_test, svm_pred_test),\n",
    "        brier_score_loss(y_test, knn_pred_test),\n",
    "        brier_score_loss(y_test, rf_pred_test),\n",
    "        brier_score_loss(y_test, gb_pred_test),\n",
    "        brier_score_loss(y_test, nn_pred_test)\n",
    "    ]\n",
    "}).round(4).sort_values('Brier_Score')\n",
    "\n",
    "print(f\"Brier Scores (Test Set):\")\n",
    "print(f\"Naive baseline (always predict mean): {brier_baseline:.4f}\")\n",
    "print(f\"\\n{brier_scores.to_string(index=False)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11 -- Save Models & Tables"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Result:** All 6 models, comparison table, feature importance saved."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create output directories\n",
    "model_dir = '/mnt/user-data/uploads/Repos--credit-risk-portfolio/phase2_challenger_models/01_lendingclub/models'\n",
    "table_dir = '/mnt/user-data/uploads/Repos--credit-risk-portfolio/phase2_challenger_models/01_lendingclub/data/04_assets/tables'\n",
    "\n",
    "os.makedirs(model_dir, exist_ok=True)\n",
    "os.makedirs(table_dir, exist_ok=True)\n",
    "\n",
    "# Save models\n",
    "models_dict = {\n",
    "    'lda': lda,\n",
    "    'svm': svm,\n",
    "    'knn': knn,\n",
    "    'random_forest': rf,\n",
    "    'gradient_boosting': gb,\n",
    "    'neural_network': nn,\n",
    "    'scaler': scaler\n",
    "}\n",
    "\n",
    "for name, model in models_dict.items():\n",
    "    if name != 'scaler':\n",
    "        joblib.dump(model, os.path.join(model_dir, f'{name}_v1.joblib'))\n",
    "        print(f\"✓ {name}_v1.joblib saved\")\n",
    "\n",
    "# Save comparison table\n",
    "comparison.to_csv(os.path.join(table_dir, 'ml_toolkit_comparison_table.csv'), index=False)\n",
    "print(f\"\\n✓ Comparison table saved: ml_toolkit_comparison_table.csv\")\n",
    "\n",
    "# Save feature importance\n",
    "feature_importance_combined = pd.DataFrame({\n",
    "    'feature': feature_cols,\n",
    "    'random_forest': rf.feature_importances_,\n",
    "    'gradient_boosting': gb.feature_importances_\n",
    "}).sort_values('random_forest', ascending=False)\n",
    "feature_importance_combined.to_csv(os.path.join(table_dir, 'feature_importance_comparison.csv'), index=False)\n",
    "print(f\"✓ Feature importance saved: feature_importance_comparison.csv\")\n",
    "\n",
    "# Save Brier scores\n",
    "brier_scores.to_csv(os.path.join(table_dir, 'ml_toolkit_brier_scores.csv'), index=False)\n",
    "print(f\"✓ Brier scores saved: ml_toolkit_brier_scores.csv\")\n",
    "\n",
    "print(f\"\\n✅ Phase 2, Notebook 02 (ML Toolkit) complete.\")"
   ]
  }
 ],
